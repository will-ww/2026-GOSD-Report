\newcommand{\Pos}[2]{([xshift=#1mm,yshift=-#2mm]current page.north west)}
\newsavebox{\auditbox}
\renewcommand{\Box}[5]{\node[anchor=north west,inner sep=0pt,outer sep=0pt] at \Pos{#2}{#3}{\sbox{\auditbox}{\begin{minipage}[t]{#4mm}#5\end{minipage}}\typeout{AUDITBOX|#1|#2|#3|#4|\the\dimexpr\ht\auditbox+\dp\auditbox\relax}\usebox{\auditbox}};}
\newcommand{\CenterBox}[5]{\node[anchor=west,inner sep=0pt,outer sep=0pt] at \Pos{#2}{#3}{\sbox{\auditbox}{\begin{minipage}[c]{#4mm}#5\end{minipage}}\typeout{AUDITBOX|#1|#2|#3|#4|\the\dimexpr\ht\auditbox+\dp\auditbox\relax}\usebox{\auditbox}};}
\newcommand{\Rect}[5]{\pgfmathsetmacro{\Rx}{#1+#3}\pgfmathsetmacro{\Ry}{#2+#4}\fill[#5] \Pos{#1}{#2} rectangle \Pos{\Rx}{\Ry};}
\newcommand{\Rule}[4]{\draw[#4,line width=.45pt] \Pos{#1}{#2} -- \Pos{#3}{#2};}
