{
  "SECMAP": {
    "Agentic coding": {
      "name": "编码代理",
      "stage": "application",
      "description": "把需求转化为代码、变更与测试，提供人机协作的任务入口。"
    },
    "Coding workflows & harnesses": {
      "name": "编码工作流与工具链",
      "stage": "application",
      "description": "组织编码任务的上下文、规则与执行流程。"
    },
    "Personal AI assistants": {
      "name": "个人助手",
      "stage": "application",
      "description": "围绕个人任务、日常工具和持续上下文提供协助。"
    },
    "Chatbot workspaces": {
      "name": "聊天工作区",
      "stage": "application",
      "description": "以对话和工作区承载模型、知识与工具的交互。"
    },
    "Multi-agent orchestration": {
      "name": "多代理编排",
      "stage": "framework",
      "description": "组织多个 Agent 的角色、任务分工与交接。"
    },
    "Workflow & agent builders": {
      "name": "工作流与代理构建",
      "stage": "framework",
      "description": "用可视化或声明式流程连接任务、模型和工具。"
    },
    "Code-first frameworks": {
      "name": "代码优先框架",
      "stage": "framework",
      "description": "为开发者提供构建 Agent 应用的程序接口与框架。"
    },
    "Memory, knowledge & context": {
      "name": "记忆、知识与上下文",
      "stage": "runtime",
      "description": "组织可检索知识、长期记忆和任务状态。"
    },
    "Protocols & interoperability": {
      "name": "协议与互操作",
      "stage": "runtime",
      "description": "定义 Agent、工具及界面之间可共同使用的接口。"
    },
    "Tools, web & computer use": {
      "name": "工具与计算机使用",
      "stage": "runtime",
      "description": "把模型输出连接到浏览器、业务工具与可执行动作。"
    },
    "Development sandboxes": {
      "name": "开发沙箱",
      "stage": "runtime",
      "description": "为代码执行提供环境、隔离与生命周期管理。"
    },
    "Observability & evaluation": {
      "name": "可观测与评估",
      "stage": "runtime",
      "description": "记录执行过程、评估任务结果并定位失败。"
    },
    "Model API gateways": {
      "name": "模型 API 网关",
      "stage": "model",
      "description": "模型调用入口、路由与接入管理。"
    },
    "Serving · Deploy": {
      "name": "服务部署",
      "stage": "model",
      "description": "组织模型服务的部署和运行。"
    },
    "Serving · Inference": {
      "name": "推理引擎",
      "stage": "model",
      "description": "支撑模型推理执行与资源效率。"
    },
    "Post-Train · RL & environments": {
      "name": "强化学习与环境",
      "stage": "model",
      "description": "为后训练提供交互环境与强化学习工具。"
    },
    "Post-Train · Supervised fine-tuning": {
      "name": "监督微调",
      "stage": "model",
      "description": "支持模型的任务适配和监督训练。"
    },
    "Pre-Train · Framework & parallel": {
      "name": "训练框架与并行",
      "stage": "model",
      "description": "承载训练计算与分布式执行。"
    },
    "Pre-Train · Evaluation & observability": {
      "name": "训练评估与观测",
      "stage": "model",
      "description": "观察训练过程、实验与模型行为。"
    },
    "Pre-Train · Robotics infra": {
      "name": "机器人基础设施",
      "stage": "model",
      "description": "为具身任务提供训练和开发工具。"
    },
    "Pre-Train · Compiler & accelerator": {
      "name": "编译器与加速",
      "stage": "model",
      "description": "连接模型计算与底层硬件。"
    },
    "Data · Labeling": {
      "name": "数据标注",
      "stage": "model",
      "description": "组织训练数据的标注与质量过程。"
    },
    "Data · Integration": {
      "name": "数据集成",
      "stage": "model",
      "description": "连接和处理模型工作流中的数据。"
    },
    "Data · Governance": {
      "name": "数据治理",
      "stage": "model",
      "description": "维护数据结构、版本与可管理性。"
    },
    "Compute & scheduling": {
      "name": "计算与调度",
      "stage": "model",
      "description": "为模型计算组织资源、调度和运行管理。"
    }
  },
